# listmonk API (Contabo VPS — replaces Mautic, decommissioned 2026-06-14)
LISTMONK_BASE_URL=http://79.143.180.209:9000
LISTMONK_API_USER=marketing-bot
LISTMONK_API_TOKEN=replace-me

# listmonk list ID for Lead Bites contacts (list 3 = "All Contacts")
LISTMONK_LIST_ID=3

# App password (single password for the upload form)
UPLOAD_PASSWORD=replace-me

# Iron-session secret — must be a random string of at least 32 chars
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=replace-me-with-32-random-bytes-hex
